{
  "type": "origins:multiple",
  "resource": {
    "type": "origins:resource",
    "max": 300,
    "min": 0,
    "start_value": 300,
    "hud_render": {
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
      "bar_index": 5
    }
  },
  "toggle": {
    "type": "origins:toggle",
    "key": "key.origins.primary_active",
    "active_by_default": false
  },
  "invulnerability": {
    "type": "origins:invulnerability",
    "damage_condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:name",
          "name": "inWall"
        },
        {
          "type": "origins:name",
          "name": "fall"
        }
      ]
    },
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power_active",
        "power": "*:*_toggle"
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "*:*_resource",
        "change": -1
      },
      "else_action": {
        "type": "origins:change_resource",
        "resource": "*:*_resource",
        "change": 1
      }
    }
  },
  "phase": {
    "type": "origins:phasing",
    "blacklist": true,
    "render_type": "blindness",
    "view_distance": 20,
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    },
    "block_condition": {
      "type": "origins:in_tag",
      "tag": "origins:unphasable"
    },
    "phase_down_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:swimming"
            },
            {
              "type": "origins:sneaking"
            }
          ]
        }
      ]
    }
  },
  "respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:execute_command",
      "command": "resource set @s origins-plus-plus:devine-architect/phase_resource 500"
    }
  }
}
