@echo off
rem ---------------------------------------------------------------
rem  Тихая авто-синхронизация сборки перед запуском игры.
rem  1) читает ИНСТРУКЦИЮ ЗАГРУЗКИ (bootstrap.txt) по двум неизменным адресам
rem  2) качает пак с первого доступного источника (с повторами при обрывах)
rem  3) один раз докладывает настройки/конфиги тем, у кого их ещё нет
rem  Всегда возвращает 0, иначе PrismLauncher отменил бы запуск игры.
rem ---------------------------------------------------------------
setlocal enabledelayedexpansion

set "PTR_HOST=http://26.26.205.227:8787/bootstrap.txt"
set "PTR_NET=https://raw.githubusercontent.com/CrystalysGolem/minecraft-pack-1201/main/bootstrap.txt"
set "FALLBACK_PACK=https://raw.githubusercontent.com/CrystalysGolem/minecraft-pack-1201/main/pack.toml"
set "BOOTFILE=%TEMP%\mcp1201_%RANDOM%.txt"
set "STARTER=%TEMP%\mcp1201_starter_%RANDOM%.txt"
set "ATTEMPTS=2"

set "TIMEOUT=8"
set "INSTALL_TRIES=2"
set "WAIT=3"

set "JAVA="
for %%P in ("%APPDATA%\PrismLauncher\java\java-runtime-gamma\bin\java.exe") do if exist %%P set "JAVA=%%~P"
if not defined JAVA for /d %%D in ("%APPDATA%\PrismLauncher\java\*") do if exist "%%D\bin\java.exe" set "JAVA=%%D\bin\java.exe"
if not defined JAVA where java >nul 2>nul && set "JAVA=java"
if not defined JAVA (echo [packwiz] Java не найдена - синхронизация пропущена. & exit /b 0)

rem --- 1. инструкция загрузки: сначала с хоста (Radmin), потом из сети
set "BOOT="
ping -n 1 -w 700 26.26.205.227 >nul 2>nul
if not errorlevel 1 (
  call :fetch "%PTR_HOST%" "%BOOTFILE%" "pack=" 1
  if not errorlevel 1 set "BOOT=%BOOTFILE%"
)
if not defined BOOT (
  call :fetch "%PTR_NET%" "%BOOTFILE%" "pack=" 1
  if not errorlevel 1 set "BOOT=%BOOTFILE%"
)

rem --- 2. список источников пака
set "N=0"
set "SRC1="
if defined BOOT (
  for /f "tokens=1,* delims==" %%A in ('type "%BOOT%" 2^>nul') do (
    if /i "%%~A"=="pack" (
      set /a N+=1
      set "SRC!N!=%%~B"
    )
  )
)
if "!N!"=="0" (
  echo [packwiz] Инструкция загрузки недоступна - использую GitHub напрямую.
  set "N=1"
  set "SRC1=%FALLBACK_PACK%"
)

rem --- 3. установка: источники по порядку, каждый с повторами при обрыве
set "OK="
set "USED="
for /l %%I in (1,1,!N!) do (
  if not defined OK (
    set "U=!SRC%%I!"
    if defined U (
      call :reachable "!U!"
      if not errorlevel 1 (
        echo [packwiz] Источник %%I: !U!
        call :install "!U!"
        if not errorlevel 1 (
          set "OK=1"
          set "USED=!U!"
        )
      ) else (
        echo [packwiz] Источник %%I недоступен, пропускаю.
      )
    )
  )
)

rem --- 4. настройки владельца (принудительно, один раз на версию набора)
call :settings

rem --- 5. включить ресурспаки с фиксами (файл уже скачан вместе с паком)
call :fixpacks

rem --- 5. настройки для первого запуска (один раз, только отсутствующие файлы)
if defined USED (
  set "BASE=!USED:/pack.toml=!"
  call :seed "!BASE!"
)

if defined OK (
  call :selfupdate
  del "%BOOTFILE%" >nul 2>nul
  exit /b 0
)
echo [packwiz] Обновиться не удалось - игра запустится на текущих файлах.
call :selfupdate
del "%BOOTFILE%" >nul 2>nul
exit /b 0

:settings
rem Набор настроек владельца кладём ПОВЕРХ настроек игрока - один раз на версию набора.
if not exist "settings\manifest.txt" exit /b 0
set "SVER="
for /f "usebackq tokens=1,* delims==" %%A in ("settings\manifest.txt") do if not defined SVER if /i "%%~A"=="#version" set "SVER=%%~B"
if not defined SVER exit /b 0
set "SOLD="
if exist ".pack_settings" for /f "usebackq delims=" %%X in (".pack_settings") do if not defined SOLD set "SOLD=%%X"
if "!SOLD!"=="!SVER!" exit /b 0
echo [packwiz] Применяю настройки владельца (набор !SVER!)
if not exist "settings\files" exit /b 0
xcopy "settings\files\*" "." /E /I /Y /Q >nul 2>nul
if exist "settings\instance\patches" xcopy "settings\instance\patches\*" "..\patches\" /E /I /Y /Q >nul 2>nul
if exist "settings\instance\instance.cfg.overrides" powershell -NoProfile -EncodedCommand  >nul 2>nul
> ".pack_settings" echo !SVER!
exit /b 0
:fixpacks
rem Включает наши ресурспаки с фиксами: игра видит ресурспак только если он в options.txt.
rem Наш пак дописываем В КОНЕЦ списка - в resourcePacks побеждает последний пак, иначе мод перекрывает фикс.
if not exist "options.txt" exit /b 0
powershell -NoProfile -EncodedCommand  >nul 2>nul
exit /b 0

rem ---------------- установка пакета ----------------
:install
set "URL=%~1"
set "TRY=0"
:install_again
set /a TRY+=1
"%JAVA%" -jar packwiz-installer-bootstrap.jar -g -s client "%URL%"
if %TRY% GEQ %INSTALL_TRIES% exit /b 1
call :reachable "%URL%"
if errorlevel 1 exit /b 1
echo [packwiz] Обрыв связи. Повтор установки (%TRY%/%INSTALL_TRIES%) через %WAIT% c...
call :sleep %WAIT%
goto :install_again

rem ---------------- настройки первого запуска ----------------
:seed
rem %~1 = базовый адрес источника (без /pack.toml)
set "SBASE=%~1"
if not exist "packwiz-installer-bootstrap.jar" exit /b 0
call :fetch "%SBASE%/starter/manifest.txt" "%STARTER%" "#version="
if errorlevel 1 exit /b 0
set "SVER="
for /f "tokens=1,* delims==" %%A in ('type "%STARTER%" 2^>nul') do (
  if /i "%%~A"=="#version" if not defined SVER set "SVER=%%~B"
)
set "SOLD="
if exist ".pack_starter" for /f "usebackq tokens=* delims=" %%L in (".pack_starter") do if not defined SOLD set "SOLD=%%L"
if defined SVER if "!SVER!"=="!SOLD!" exit /b 0
set "SEEDED=0"
for /f "usebackq tokens=* delims=" %%L in ("%STARTER%") do (
  set "LINE=%%L"
  if not "!LINE!"=="" if not "!LINE:~0,1!"=="#" call :seed_one "!SBASE!" "!LINE!"
)
if not "!SEEDED!"=="0" echo [packwiz] Настройки первого запуска: выдано файлов !SEEDED!.
if defined SVER echo !SVER!> ".pack_starter"
del "%STARTER%" >nul 2>nul
exit /b 0

:seed_one
rem %~1 = база, %~2 = путь относительно minecraft/
set "REL=%~2"
if exist "%REL%" exit /b 0
for %%D in ("%REL%") do if not "%%~dpD"=="" if not exist "%%~dpD" mkdir "%%~dpD" >nul 2>nul
call :fetch "%~1/starter/%REL%" "%REL%" ""
if not errorlevel 1 set /a SEEDED+=1
exit /b 0

rem ---------------- вспомогательные ----------------
:sleep
rem %~1 = секунды (через ping - работает и без интерактивной консоли)
set /a "SL=%~1"
if %SL% LSS 1 set "SL=1"
ping -n %SL% 127.0.0.1 >nul 2>nul
exit /b 0

:fetch
rem %~1 = URL, %~2 = куда сохранить, %~3 = строка-признак (пусто = просто непустой файл)
set "FURL=%~1"
set "FDST=%~2"
set "FMARK=%~3"

set "FMAX=%~4"

if not defined FMAX set "FMAX=%ATTEMPTS%"
set "FTRY=0"
:fetch_again
set /a FTRY+=1
call :direct "%FURL%" "%FDST%"
if not errorlevel 1 (
  call :looks_ok "%FDST%" "%FMARK%"
)
if exist "%FDST%" del "%FDST%" >nul 2>nul
if %FTRY% GEQ %FMAX% exit /b 1
call :sleep 3
goto :fetch_again

:direct
rem скачивание без прокси: curl.exe, иначе PowerShell (WebClient, Proxy=$null)
curl.exe -fsS --noproxy "*" -m %TIMEOUT% -o "%~2" "%~1" >nul 2>nul
if exist "%~2" for %%F in ("%~2") do if %%~zF GTR 0 exit /b 0
powershell -NoProfile -Command "try{$w=New-Object Net.WebClient;$w.Proxy=$null;$w.DownloadFile('%~1','%~2')}catch{exit 1}" >nul 2>nul
if exist "%~2" for %%F in ("%~2") do if %%~zF GTR 0 exit /b 0
exit /b 1

:looks_ok
rem %~1 = файл, %~2 = обязательная подстрока (пусто = достаточно непустого файла)
if not exist "%~1" exit /b 1
for %%F in ("%~1") do if %%~zF LSS 1 exit /b 1
if "%~2"=="" exit /b 0
findstr /b /c:"%~2" "%~1" >nul 2>nul
if errorlevel 1 exit /b 1
exit /b 0

:reachable
rem %~1 = URL источника. Для адресов-по-IP быстрый ping (иначе TCP-таймаут ~20 c).
set "H=%1"
set "HOST="
for /f "tokens=1,2,3 delims=:/" %%a in ("%H%") do set "HOST=%%b"
if not defined HOST exit /b 0
echo %HOST%| findstr /r /c:"^[0-9][0-9]*\.[0-9]" >nul
if errorlevel 1 exit /b 0
ping -n 1 -w 700 %HOST% >nul 2>nul
exit /b %errorlevel%

:selfupdate
rem Пак может привезти новую версию скрипта (<скрипт>.new) - подхватываем её сами.
rem Делаем это ПОСЛЕДНИМ действием: подмена файла во время его выполнения может порвать строки.
if exist "%~dpn0.new" move /y "%~dpn0.new" "%~f0" >nul 2>nul
if exist "minecraft\%~n0.new" move /y "minecraft\%~n0.new" "%~f0" >nul 2>nul
exit /b 0
